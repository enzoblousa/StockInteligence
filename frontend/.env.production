# Usado automaticamente pelo Vite quando roda `npm run build` (modo
# produção). Fica "assado" nos arquivos estáticos gerados — não é lido em
# runtime, então trocar isso exige rebuildar e reimplantar (não é como uma
# variável de ambiente de um app Java, que é lida quando o processo sobe).
#
# URL da Route do backend no OpenShift (infra/openshift/11-backend-route.yaml).
# Se o namespace for recriado ou o backend for reimplantado com outro nome
# de Route, confirme o valor real com:
#   oc get route backend -o jsonpath='{.spec.host}'
VITE_API_BASE_URL=https://backend-enzoblousa-dev.apps.rm2.thpm.p1.openshiftapps.com
